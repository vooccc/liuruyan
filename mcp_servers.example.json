    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "env": {},
      "url": null,
      "headers": {},
      "transport": null,
      "enabled": false,
      "timeout": 120,
      "connect_timeout": 60,
      "description": "本地 Git 仓库交互：log / diff / show / blame。",
      "cwd": null,
      "agents": [
        "*"
      ],
      "concurrency_class": "read",
      "sampling": {
        "enabled": false,
        "allowed_models": [],
        "max_tokens_cap": 4096,
        "max_rpm": 10
      },
      "elicitation": {
        "enabled": true,
        "timeout_seconds": 60
      },
      "oauth": null
    },
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp"
      ],
      "env": {},
      "url": null,
      "headers": {},
      "transport": null,
      "enabled": true,
      "timeout": 120,
      "connect_timeout": 60,
      "description": "CodeGraph 本地代码知识图谱：symbol search、context、callers/callees、impact、trace。",
      "cwd": ".",
      "agents": [
        "*"
      ],
      "concurrency_class": "read",
      "sampling": {
        "enabled": false,
        "allowed_models": [],
        "max_tokens_cap": 4096,
        "max_rpm": 10
      },
      "elicitation": {
        "enabled": true,
        "timeout_seconds": 60
      },
      "oauth": null
    }
  }
}