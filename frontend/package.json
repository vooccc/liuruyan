{
  "name": "liuruyan-agent",
  "private": true,
  "version": "2.0.17",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "node scripts/tauri-before-dev.mjs",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ../backend/build_backend.ps1",
    "package": "npm run build:backend && tauri build --ignore-version-mismatches",
    "package:lite": "tauri build --ignore-version-mismatches",
    "package:lite:full": "npm run build:backend && tauri build --ignore-version-mismatches"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@lobehub/icons": "^5.6.0",
    "@tauri-apps/api": "~2.10.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "highlight.js": "^11.11.1",
    "immer": "^11.1.4",
    "lucide-react": "^0.300.0",
    "marked": "^18.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.8"
  }
}
